#!/bin/sh
# vm - boot, reach and throw away the machines in machines/. `vm help` for
# the commands, `vm` alone for the dashboard; the app is apps/vm.
#
# Symlinked onto PATH by mr's link_bins, so it resolves the link back to this
# repo rather than trusting $0's directory. VMS_REPO points it at another
# repo's machines/ instead - what an extending repo's own shim sets (vms-dfs's
# bin/vm-dfs, with this repo as its libs/vms).
set -eu

_root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [ ! -f "$_root/libs/dev-tools/package.json" ]; then
    printf 'vm: libs/dev-tools (a submodule) is missing - run:\n  git -C %s submodule update --init\n' "$_root" >&2
    exit 1
fi
# First run, or after a fresh clone: the Bun workspace (this repo's apps +
# libs/dev-tools) isn't installed yet.
if [ ! -d "$_root/node_modules" ]; then
    (cd "$_root" && bun install >&2)
fi

exec bun "$_root/apps/vm/src/main.ts" "$@"
