#!/usr/bin/env bash
# vm - boot, reach and throw away the machines defined in machines/.
#
#   vm ls                  every machine, and whether it's running
#   vm up [-d] <name>      build if needed, then boot - attached to this
#                          terminal (serial console) or its own window (gui
#                          machines); -d boots it in the background instead
#   vm ssh <name> [cmd]    ssh in as the machine's user (waits for sshd)
#   vm lock <name>         resolve the machine's apt packages into
#                          machines/<name>.lock.json - every .deb with its
#                          hash, which is all an Ubuntu machine installs from
#   vm key <name>          the public half of the machine's own key, vm-ssh -
#                          the guest user's ~/.ssh/id_ed25519, e.g. for GitHub
#   vm down <name>         power it off, keep its disk for the next `up`
#   vm kill <name>         power it off and delete everything it wrote,
#                          vm-ssh included (and its GitHub copy, if gh can)
#
# Every machine's state - its disk overlay, seed, SSH port, console log, its
# vm-ssh key and a GC root for its build - lives in one directory, so `kill`
# is a single rm -rf and leaves nothing behind on the host.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/vms"
key="$state_root/id_ed25519"

die() { printf 'vm: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0" | sed '/^$/d'
  exit "${1:-0}"
}

machines() {
  for f in "$repo"/machines/*.nix; do
    basename "$f" .nix
  done | sort
}

need_machine() {
  [ -n "${1:-}" ] || usage 1
  [ -f "$repo/machines/$1.nix" ] || die "no machine '$1' (see: vm ls)"
  dir="$state_root/$1"
}

pid_of() {
  local pidfile="$state_root/$1/qemu.pid"
  [ -f "$pidfile" ] || return 1
  local pid
  pid="$(cat "$pidfile")"
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

# The machine's own keypair: generated once per machine, handed to the guest
# user as ~/.ssh/id_ed25519 on every boot (see lib/default.nix, VM_USER_KEY),
# and gone with the state dir on `vm kill`. Named vm-ssh - its comment, and
# the title to give it on GitHub.
ensure_user_key() {
  mkdir -p "$dir"
  [ -f "$dir/vm-ssh" ] && return 0
  ssh-keygen -q -t ed25519 -N '' -C vm-ssh -f "$dir/vm-ssh"
  printf '%s: new key vm-ssh - vm key %s prints it, to add on GitHub as vm-ssh\n' "$1" "$1" >&2
}

port_free() {
  ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

cmd_ls() {
  local m status pid
  for m in $(machines); do
    if pid="$(pid_of "$m")"; then
      status="running  ssh :$(cat "$state_root/$m/ssh-port")  pid $pid"
    elif [ -d "$state_root/$m" ]; then
      status="stopped  (disk kept - vm kill $m to drop it)"
    else
      status="-"
    fi
    printf '%-14s %s\n' "$m" "$status"
  done
}

cmd_up() {
  local detach=0
  if [ "${1:-}" = -d ]; then detach=1; shift; fi
  need_machine "${1:-}"
  local name="$1"
  if pid_of "$name" >/dev/null; then
    die "$name is already running (vm ssh $name, or vm down $name)"
  fi

  mkdir -p "$dir"
  [ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "vm@$(hostname)" -f "$key"
  ensure_user_key "$name"

  nix build "$repo#$name" --out-link "$dir/runner"

  if [ ! -f "$dir/ssh-port" ] || ! port_free "$(cat "$dir/ssh-port")"; then
    local port=2222
    while ! port_free "$port"; do port=$((port + 1)); done
    printf '%s\n' "$port" > "$dir/ssh-port"
  fi

  export VM_STATE="$dir" VM_PUBKEY="$key.pub" VM_USER_KEY="$dir/vm-ssh"
  VM_SSH_PORT="$(cat "$dir/ssh-port")"
  export VM_SSH_PORT

  # shellcheck source=/dev/null
  . "$dir/runner/meta"
  if [ "$detach" = 1 ]; then
    rm -f "$dir/qemu.pid"
    setsid "$dir/runner/bin/vm-run" </dev/null >"$dir/console.log" 2>&1 &
    # Back only once QEMU has written its pidfile, so an immediate
    # `vm ssh`/`vm ls` sees it running rather than stopped.
    local launcher=$! tries=0
    until pid_of "$name" >/dev/null; do
      kill -0 "$launcher" 2>/dev/null || die "$name failed to start - see $dir/console.log"
      tries=$((tries + 1))
      [ "$tries" -lt 100 ] || die "$name has no QEMU pid after 20s - see $dir/console.log"
      sleep 0.2
    done
    printf '%s booting in the background - console: %s\n' "$name" "$dir/console.log"
    printf 'vm ssh %s   to get in (waits for it to come up)\n' "$name"
  else
    # shellcheck disable=SC2154 # gui comes from the sourced meta
    if [ "$gui" = false ]; then
      printf 'Serial console - Ctrl-a x powers the VM off. vm ssh %s works from another terminal.\n' "$name"
    fi
    exec "$dir/runner/bin/vm-run"
  fi
}

# ssh_opts STATE_DIR: the options that reach the guest booted from STATE_DIR.
ssh_opts() {
  opts=(
    -i "$key" -p "$(cat "$1/ssh-port")"
    -o IdentitiesOnly=yes -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5
  )
}

# wait_ssh NAME STATE_DIR: retry while the guest is still booting (sshd not
# up yet, or on Ubuntu, cloud-init not done creating the user): ssh's own
# failures are 255. Needs `user` from the sourced meta and `opts`.
wait_ssh() {
  local tries=0 pid
  # shellcheck disable=SC2154 # user comes from the sourced meta
  until ssh "${opts[@]}" -o BatchMode=yes "$user@127.0.0.1" true 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -lt 60 ] || die "no SSH after 5 minutes - see $2/console.log, or vm up without -d"
    [ "$tries" = 1 ] && printf 'waiting for %s to come up...\n' "$1" >&2
    pid="$(cat "$2/qemu.pid" 2>/dev/null)" || pid=''
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then die "$1 stopped while waiting"; fi
    sleep 5
  done
}

cmd_ssh() {
  need_machine "${1:-}"
  local name="$1"; shift
  pid_of "$name" >/dev/null || die "$name isn't running (vm up $name)"
  # shellcheck source=/dev/null
  . "$dir/runner/meta"
  ssh_opts "$dir"
  wait_ssh "$name" "$dir"
  exec ssh "${opts[@]}" "$user@127.0.0.1" "$@"
}

# `vm lock`: boot the machine's image as it starts out (its apt preferences,
# nothing installed - VM_LOCK=1, see lib/ubuntu.nix) in a scratch state dir,
# ask apt what installing its packages takes today, and write that down:
# every .deb's pool path, file name and sha256, and the moment it was
# resolved (the snapshot the build falls back to for a file the archive has
# pruned since). The only step that resolves versions; everything after
# installs from these hashes alone.
cmd_lock() {
  need_machine "${1:-}"
  local name="$1" lock="$repo/machines/$1.lock.json"
  mkdir -p "$dir"
  [ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "vm@$(hostname)" -f "$key"
  ensure_user_key "$name"
  nix build "$repo#$name" --out-link "$dir/runner"
  # shellcheck source=/dev/null
  . "$dir/runner/meta"
  # shellcheck disable=SC2154 # packages comes from the sourced meta
  if [ -z "$packages" ]; then
    printf '%s installs no apt packages - nothing to lock\n' "$name"
    return 0
  fi

  # Global, not local: the EXIT trap below runs after this function returns.
  lock_scratch="$dir/lock"
  local scratch="$lock_scratch" port=2222
  rm -rf "$scratch"
  mkdir -p "$scratch"
  while ! port_free "$port"; do port=$((port + 1)); done
  printf '%s\n' "$port" > "$scratch/ssh-port"
  trap 'kill "$(cat "$lock_scratch/qemu.pid" 2>/dev/null)" 2>/dev/null; rm -rf "$lock_scratch"' EXIT
  VM_STATE="$scratch" VM_PUBKEY="$key.pub" VM_USER_KEY="$dir/vm-ssh" VM_SSH_PORT="$port" VM_LOCK=1 \
    setsid "$dir/runner/bin/vm-run" </dev/null >"$scratch/console.log" 2>&1 &
  local tries=0
  until [ -s "$scratch/qemu.pid" ]; do
    tries=$((tries + 1))
    [ "$tries" -lt 100 ] || die "no QEMU pid after 20s - see $scratch/console.log"
    sleep 0.2
  done

  ssh_opts "$scratch"
  wait_ssh "$name (lock)" "$scratch"
  local snapshot
  snapshot="$(date -u +%Y%m%dT%H%M%SZ)"
  printf 'resolving %s...\n' "$packages" >&2
  # apt's plan (--print-uris) names each .deb but carries only its MD5; the
  # sha256 comes from the Packages indexes apt just fetched and verified
  # against the signed InRelease. URIs are %-escaped (+ is %2b), index
  # Filenames aren't. Out: "<pool path> <sha256>" per .deb.
  # shellcheck disable=SC2086 # packages is a word list on purpose
  ssh "${opts[@]}" "$user@127.0.0.1" bash -s -- $packages >"$scratch/resolved" <<'RESOLVE' ||
set -e
sudo cloud-init status --wait >/dev/null
sudo apt-get -qq update >&2
sudo apt-get -qq install --print-uris -y "$@" > /tmp/vms-uris
awk -v q="'" '
  function unescape(s,   out, i, c) {
    out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "%") {
        out = out sprintf("%c", (index("0123456789abcdef", tolower(substr(s, i + 1, 1))) - 1) * 16 \
          + index("0123456789abcdef", tolower(substr(s, i + 2, 1))) - 1)
        i += 2
      } else out = out c
    }
    return out
  }
  $1 ~ /[.]deb.$/ { u = $1; gsub(q, "", u); sub(/^.*[/]pool[/]/, "pool/", u); print unescape(u) }
' /tmp/vms-uris > /tmp/vms-want
for f in $(apt-get indextargets --format '$(FILENAME)' 'Identifier: Packages'); do
  /usr/lib/apt/apt-helper cat-file "$f"
done | awk '/^Filename: /{fn=$2} /^SHA256: /{print fn, $2}' > /tmp/vms-hashes
awk 'NR==FNR{h[$1]=$2; next} {print $1, ($1 in h ? h[$1] : "MISSING")}' /tmp/vms-hashes /tmp/vms-want
RESOLVE
    die "apt couldn't resolve $packages - see above"
  if grep -q ' MISSING$' "$scratch/resolved"; then
    die "no sha256 in apt's indexes for: $(grep ' MISSING$' "$scratch/resolved" | cut -d' ' -f1 | head -5 | tr '\n' ' ')"
  fi

  {
    printf '{\n  "snapshot": "%s",\n  "packages": [' "$snapshot"
    local sep='' p
    for p in $packages; do printf '%s"%s"' "$sep" "$p"; sep=', '; done
    printf '],\n  "debs": [\n'
    awk '{
      n = split($1, parts, "/")
      printf "%s    { \"file\": \"%s\", \"path\": \"%s\", \"sha256\": \"%s\" }", (NR > 1 ? ",\n" : ""), parts[n], $1, $2
    } END { if (NR) printf "\n" }' "$scratch/resolved"
    printf '  ]\n}\n'
  } >"$lock.tmp"
  local count
  count="$(grep -c '"file"' "$lock.tmp" || true)"
  if [ "$count" = 0 ]; then
    rm -f "$lock.tmp"
    die "apt's plan for $packages had no .debs in it"
  fi
  mv "$lock.tmp" "$lock"
  printf '%s: %s .debs locked in %s\n' "$name" "$count" "$lock"
  printf 'the flake only sees tracked files: git add %s\n' "${lock#"$repo"/}"
}

stop() {
  local pid
  pid="$(pid_of "$1")" || return 0
  kill "$pid"
  while kill -0 "$pid" 2>/dev/null; do sleep 0.2; done
}

cmd_down() {
  need_machine "${1:-}"
  stop "$1"
}

cmd_key() {
  need_machine "${1:-}"
  ensure_user_key "$1"
  cat "$dir/vm-ssh.pub"
}

# `vm kill` deletes vm-ssh with everything else; a copy added to GitHub
# would outlive it. With gh signed in and allowed to (scope admin:public_key),
# that copy - the key whose text is exactly this one, nothing else - is
# deleted too; without, it's named so it can be removed by hand.
forget_user_key() {
  [ -f "$dir/vm-ssh.pub" ] || return 0
  local pub id
  pub="$(cut -d' ' -f1,2 "$dir/vm-ssh.pub")"
  if command -v gh >/dev/null 2>&1 &&
    id="$(gh api user/keys --jq ".[] | select(.key == \"$pub\") | .id" 2>/dev/null)"; then
    if [ -n "$id" ] && gh api -X DELETE "user/keys/$id" >/dev/null 2>&1; then
      printf '%s: removed vm-ssh from GitHub\n' "$1" >&2
    fi
    return 0
  fi
  printf '%s: vm-ssh (%s) is deleted - if you added it to GitHub, remove it there too\n' \
    "$1" "$(ssh-keygen -lf "$dir/vm-ssh.pub" | cut -d' ' -f2)" >&2
}

cmd_kill() {
  need_machine "${1:-}"
  stop "$1"
  forget_user_key "$1"
  rm -rf "$dir"
}

case "${1:-}" in
  ls) shift; cmd_ls "$@" ;;
  up) shift; cmd_up "$@" ;;
  ssh) shift; cmd_ssh "$@" ;;
  key) shift; cmd_key "$@" ;;
  lock) shift; cmd_lock "$@" ;;
  down) shift; cmd_down "$@" ;;
  kill) shift; cmd_kill "$@" ;;
  -h | --help | help) usage ;;
  *) usage 1 ;;
esac
