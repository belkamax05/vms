{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // dev-tools is the @belkamax05/dev-tools package (../../package.json),
    // installed from GitHub with the same react/ink ranges as ours - which
    // makes them one copy, so its components can be rendered here.
    "paths": {
      "@/dev-tools/*": ["../../node_modules/@belkamax05/dev-tools/libs/*"]
    }
  }
}
